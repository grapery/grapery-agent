# 已拆分为 dev / prod 模板，请按需复制（勿覆盖已有 .env）：
#
#   [ ! -f .env ] && cp env.grapery-agent.dev.example .env    # 本地或开发 ECS
#   [ ! -f .env ] && cp env.grapery-agent.prod.example .env   # 生产字段参考（勿提交真实密钥）
#   make sync-env-from-grapery                               # 仅创建缺失 / 填空字段
#
# CI 部署时由 agent-ci.yml 按分支生成 .env，无需手抄。
