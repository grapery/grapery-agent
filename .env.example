# Grapery Agent Service 配置

# 服务端口
SERVER_PORT=9020

# Grapery 后端地址
GRAPERY_BASE_URL=http://localhost:9000
GRAPERY_API_KEY=

# Agent run trace / RL artifact JSONL 导出目录
AGENT_ARTIFACT_DIR=./data/agent-artifacts

# Eino / AI 配置
EINO_TEXT_PROVIDER=huoshan
EINO_TEXT_MODEL=ep-20250xxx-xxxxx
EINO_MAX_ITERATIONS=30
EINO_REQUEST_TIMEOUT=180

# 火山方舟 (Huoshan)
HUOSHAN_API_KEY=your-huoshan-api-key
HUOSHAN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Google Gemini (备选)
GEMINI_API_KEY=
