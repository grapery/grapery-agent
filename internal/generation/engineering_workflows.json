    "status": "released",
    "manifest": {
      "engineeringDefault": true,
      "defaultGraphVersion": 1,
      "surface": "voyager.storyboard",
      "action": "generate",
      "creativeControls": {
        "version": 1,
        "pacing": "balanced",
