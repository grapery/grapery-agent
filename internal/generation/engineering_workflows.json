          "type": "activity",
          "activity": "storyboard.generate_bible_plan",
          "dependsOn": [
            "generate_storyboard"
          ]
        },
        {
          "id": "scene_plan",
          "type": "activity",
          "activity": "storyboard.generate_scene_plan",
          "dependsOn": [
            "bible_plan"
          ]
        },
        {
          "id": "review_content",
          "type": "activity",
          "activity": "storyboard.review_content",
          "dependsOn": [
            "scene_plan"
          ]
        },
        {
          "id": "persist_content",
          "type": "persist",
          "activity": "storyboard.persist_content",
          "dependsOn": [
            "review_content"
          ]
        },
        {
          "id": "ensure_images",
          "type": "activity",
          "activity": "storyboard.ensure_images",
          "dependsOn": [
            "persist_content"
          ],
          "config": {
            "inputDefaults": {
              "generateImages": true
            }
          }
        }
      ]
    },
