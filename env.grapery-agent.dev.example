# ========== Grapery Agent — Development ==========
# 本地（勿覆盖已有 .env）：
#   [ ! -f .env ] && cp env.grapery-agent.dev.example .env
# 或：make sync-env-from-grapery  （仅创建缺失 .env / 填空字段）
# CI：agent-ci develop 分支 / workflow_dispatch(dev) 会生成等价 .env 并 SCP 到 DEV_DEPLOY_HOST

# ========== Environment ==========
ENVIRONMENT=development
GRAPERY_ENV=development
SERVICE_NAME=grapery-agent
IMAGE=crpi-xxx.cn-hangzhou.personal.cr.aliyuncs.com/grapery-dev/grapery-agent:dev

# ========== Service ==========
SERVER_PORT=9020
GRAPERY_BASE_URL=http://server:8080
GRAPERY_API_KEY=
AGENT_ARTIFACT_DIR=/app/data/agent-artifacts
LOG_LEVEL=debug

# ========== Database ==========
DB_DATABASE=grapery_dev
DB_USERNAME=root
DB_PASSWORD=your-database-password
DB_ADDRESS=your-rds-host:3306

# ========== Redis ==========
REDIS_ADDRESS=ngx-redis:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ========== Eino / AI ==========
EINO_TEXT_PROVIDER=huoshan
# 火山方舟接入点 ID（ep-xxx）或模型 ID；与 grapery 一致时可设 HUOSHAN_TEXT_MODEL
EINO_TEXT_MODEL=doubao-seed-2-0-lite-260215
HUOSHAN_TEXT_MODEL=doubao-seed-2-0-lite-260215
EINO_MAX_ITERATIONS=30
EINO_REQUEST_TIMEOUT=180
HUOSHAN_API_KEY=
HUOSHAN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
HUOSHAN_IMAGE_MODEL=doubao-seedream-5-0-260128
HUOSHAN_VIDEO_MODEL=doubao-seedance-1-5-pro-251215
GEMINI_API_KEY=
GEMINI_BASE_URL=

# ========== JWT ==========
JWT_SECRET=your-jwt-secret
JWT_EXPIRY_HOURS=24

# ========== Agent Access Token (parallel public) ==========
# 校验 grapery 签发的短期 Agent Access Token。必须与 grapery 的 AGENT_TOKEN_SIGNING_KEY 完全一致。
AGENT_TOKEN_VERIFY_KEY=
# true：缺失/非法 token 直接拒绝；false（默认）：兼容放行，便于本地/灰度过渡。
# fragment-panel 试点端点在 AGENT_TOKEN_VERIFY_KEY 已配置时始终强制 token。
AGENT_ACCESS_TOKEN_REQUIRED=false
AGENT_TOKEN_REPLAY_CACHE_ENABLED=false
AGENT_EXEC_FRAGMENT_PANEL_ENABLED=false
AUDIT_SYNC_TO_GRAPERY_ENABLED=true
# 与 grapery 的 GRAPERY_INTERNAL_API_KEY 一致，用于 agent-policy API

# ========== Aliyun OSS ==========
ALIYUN_API_KEY=
ALIYUN_SECRET_KEY=
ALIYUN_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_BUCKET=grapery-dev
ALIYUN_ROLE_ARN=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ROLE_ARN=

# ========== Aliyun SMS ==========
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_ENDPOINT=
ALIYUN_SMS_USE_DEFAULT_CREDENTIAL=1
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
