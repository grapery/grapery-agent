# ========== Grapery Agent — Production ==========
# 仅作字段参考；生产 .env 由 agent-ci main / workflow_dispatch(prod) 生成，勿将真实密钥提交仓库

# ========== Environment ==========
ENVIRONMENT=production
GRAPERY_ENV=production
SERVICE_NAME=grapery-agent
IMAGE=crpi-xxx.cn-hangzhou.personal.cr.aliyuncs.com/grapery-prod/grapery-agent:prod

# ========== Service ==========
SERVER_PORT=9020
GRAPERY_BASE_URL=http://server:8080
GRAPERY_API_KEY=
AGENT_ARTIFACT_DIR=/app/data/agent-artifacts
LOG_LEVEL=info

# ========== Database ==========
DB_DATABASE=grapery
DB_USERNAME=
DB_PASSWORD=
DB_ADDRESS=

# ========== Redis ==========
REDIS_ADDRESS=
REDIS_PASSWORD=
REDIS_DATABASE=0

# ========== Eino / AI ==========
EINO_TEXT_PROVIDER=huoshan
EINO_TEXT_MODEL=doubao-seed-2-0-lite-260215
HUOSHAN_TEXT_MODEL=doubao-seed-2-0-lite-260215
EINO_MAX_ITERATIONS=30
EINO_REQUEST_TIMEOUT=180
HUOSHAN_API_KEY=
HUOSHAN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
HUOSHAN_IMAGE_MODEL=doubao-seedream-5-0-260128
HUOSHAN_VIDEO_MODEL=doubao-seedance-1-5-pro-251215
GEMINI_API_KEY=
GEMINI_BASE_URL=

# ========== JWT ==========
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# ========== Aliyun OSS ==========
ALIYUN_API_KEY=
ALIYUN_SECRET_KEY=
ALIYUN_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_BUCKET=grapery-prod
ALIYUN_ROLE_ARN=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ROLE_ARN=

# ========== Aliyun SMS ==========
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_ENDPOINT=
ALIYUN_SMS_USE_DEFAULT_CREDENTIAL=1
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
